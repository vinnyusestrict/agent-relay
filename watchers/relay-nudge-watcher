#!/usr/bin/env python3
"""
relay-nudge-watcher — single, generalized nudge watcher for the Agent Relay.

Run ONE instance of this script per machine:

    relay-nudge-watcher <dir>

It watches <dir> for .nudge-<agent> flag files and wakes each agent's session
by injecting the flag's contents as keystrokes. The set of agents this machine
handles is discovered LIVE from the terminal multiplexer — a machine handles
exactly the agents it currently has sessions open for. Open a new agent
workspace and it is handled automatically; close it and its flags are left for
whichever machine does have it. Flags for agents this machine doesn't host are
left in place for another machine's watcher.

Session discovery & wake (same source of truth for both):
  1. cmux  — preferred when `cmux` is on PATH:
               agents  = workspace titles from `cmux tree --all --json`
               wake    = cmux send --workspace <ws> <message>
                         cmux send-key --workspace <ws> enter
  2. tmux  — used when cmux is absent:
               agents  = session names from `tmux list-sessions`
               wake    = tmux send-keys -t <session> C-u <message> Enter

  Matching is case-insensitive (.nudge-PHD wakes workspace "PHD"). The live set
  is re-discovered every poll, so it always reflects the sessions open right now.

  If a flag's agent is in the handled set but its session vanishes before the
  wake, the nudge is logged as a WARNING and the flag is still removed (the
  message was already delivered via the relay DB).

Usage:
  relay-nudge-watcher <dir> [options]

Arguments:
  dir                Directory to watch for .nudge-* flag files.
                     Optional — defaults to RELAY_NUDGE_DIR from .relay-env / env.

Options:
  --agents a,b,c     Override the live set with an explicit, static list. Use on
                     machines whose multiplexer this script can't introspect, or
                     to pin a fixed handled set. Default: discovered live (above).
  --interval <n>     Poll interval in seconds (default: 3).
  --once             Process existing flags and exit (useful for testing/cron).
  --log <path>       Append log lines to a file in addition to stdout.
                     Default: /tmp/relay-nudge-watcher.log.

Configuration:
  Reads .relay-env from its own directory (or up to two levels up), exactly as
  relay-msg does. RELAY_NUDGE_DIR provides the default watch directory.

Flag-file contract (unchanged from relay-msg):
  Filename  : .nudge-<agent-name>
  Contents  : single line of text to inject (default: "check inbox")
  After use : watcher removes the file with os.unlink()

Backwards compatibility:
  Existing per-project watchers (cmux-nudge-watcher, tmux-nudge-watcher, etc.)
  continue to work unchanged. This script is an additional entry point —
  nothing in relay-msg is modified.
"""

import argparse
import json
import os
import re
import subprocess
import sys
import time
from datetime import datetime

# ── .relay-env loader (mirrors relay-msg exactly) ────────────────────────────

def _load_env_file():
    """Load .relay-env from the script directory or up to two levels up.
    Does NOT override values already set in the environment."""
    candidates = [
        os.path.join(os.path.dirname(os.path.abspath(__file__)), ".relay-env"),
        os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", ".relay-env"),
        os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "..", ".relay-env"),
    ]
    for path in candidates:
        path = os.path.abspath(path)
        if os.path.isfile(path):
            with open(path) as f:
                for line in f:
                    line = line.strip()
                    if not line or line.startswith("#"):
                        continue
                    if "=" in line:
                        key, _, value = line.partition("=")
                        key = key.strip()
                        value = value.strip()
                        if len(value) >= 2 and value[0] == value[-1] and value[0] in ("'", '"'):
                            value = value[1:-1]
                        if key and key not in os.environ:
                            os.environ[key] = value
            break


_load_env_file()

# ── Live session discovery (the source of truth for the handled set) ──────────

def _has_cmd(name):
    return subprocess.run(["which", name], capture_output=True).returncode == 0


# cmux workspace map: "lowercased-title" -> "workspace:N" (the wake target).
_cmux_map = {}
# tmux session set: lowercased session names.
_tmux_sessions = set()


def _discover_cmux():
    """Populate _cmux_map from live cmux workspaces. Prefers --json; falls back
    to parsing the text tree for older cmux builds without --json."""
    global _cmux_map
    _cmux_map = {}
    if not _has_cmd("cmux"):
        return
    try:
        r = subprocess.run(["cmux", "tree", "--all", "--json"],
                           capture_output=True, text=True, timeout=5)
        if r.returncode == 0 and r.stdout.strip():
            data = json.loads(r.stdout)
            for win in data.get("windows", []):
                for ws in win.get("workspaces", []):
                    title = (ws.get("title") or "").strip()
                    ref = ws.get("ref")
                    if title and ref:
                        _cmux_map[title.lower()] = ref
            return
    except Exception:
        pass
    # Fallback: parse the text tree.
    try:
        r = subprocess.run(["cmux", "tree", "--all"],
                           capture_output=True, text=True, timeout=5)
        for m in re.finditer(r'workspace (workspace:\d+) "([^"]+)"', r.stdout):
            _cmux_map[m.group(2).strip().lower()] = m.group(1)
    except Exception:
        pass


def _discover_tmux():
    """Populate _tmux_sessions from live tmux sessions."""
    global _tmux_sessions
    _tmux_sessions = set()
    if not _has_cmd("tmux"):
        return
    try:
        r = subprocess.run(["tmux", "list-sessions", "-F", "#S"],
                           capture_output=True, text=True, timeout=5)
        if r.returncode == 0:
            _tmux_sessions = {s.strip().lower() for s in r.stdout.splitlines() if s.strip()}
    except Exception:
        pass


def _discover_sessions():
    """Refresh both discovery maps. cmux is preferred; tmux fills in when cmux
    hosts nothing (e.g. a tmux-only machine)."""
    _discover_cmux()
    if not _cmux_map:
        _discover_tmux()


def _live_agents():
    """The set of agent names (lowercased) with a live session on this machine."""
    return set(_cmux_map.keys()) | _tmux_sessions

# ── Session wake ──────────────────────────────────────────────────────────────

def _wake_cmux(agent, message):
    """Inject keystrokes via cmux. Returns True on success, False on no session."""
    ws = _cmux_map.get(agent.lower())
    if not ws:
        return False
    try:
        r1 = subprocess.run(["cmux", "send", "--workspace", ws, message],
                            capture_output=True, timeout=5)
        r2 = subprocess.run(["cmux", "send-key", "--workspace", ws, "enter"],
                            capture_output=True, timeout=5)
        return r1.returncode == 0 and r2.returncode == 0
    except Exception:
        return False


def _wake_tmux(agent, message):
    """Inject keystrokes via tmux. Returns True on success, False on no session."""
    target = os.environ.get(f"TMUX_TARGET_{agent.upper()}", "")
    if not target and agent.lower() in _tmux_sessions:
        target = agent
    if not target:
        return False
    try:
        r = subprocess.run(["tmux", "send-keys", "-t", target, "C-u", message, "Enter"],
                           capture_output=True, timeout=5)
        return r.returncode == 0
    except Exception:
        return False


def _wake_agent(agent, message, logger):
    """Wake via whichever multiplexer hosts the agent. Log the result."""
    if agent.lower() in _cmux_map:
        if _wake_cmux(agent, message):
            logger(f"woke {agent!r} via cmux: {message!r}")
            return
    if agent.lower() in _tmux_sessions or os.environ.get(f"TMUX_TARGET_{agent.upper()}"):
        if _wake_tmux(agent, message):
            logger(f"woke {agent!r} via tmux: {message!r}")
            return
    logger(f"WARN: no live session for {agent!r} — message was delivered to relay DB")

# ── Debounce helper ───────────────────────────────────────────────────────────

def _stable_mtime(path, debounce_secs=2, max_wait=30):
    """Wait until the file's mtime is stable for debounce_secs.
    Returns False if the file disappears during the wait."""
    waited = 0
    while True:
        try:
            mtime1 = os.stat(path).st_mtime
        except OSError:
            return False
        time.sleep(debounce_secs)
        try:
            mtime2 = os.stat(path).st_mtime
        except OSError:
            return False
        if mtime1 == mtime2:
            return True
        waited += debounce_secs
        if waited >= max_wait:
            return True  # force through after max_wait

# ── Main ──────────────────────────────────────────────────────────────────────

def main():
    parser = argparse.ArgumentParser(
        prog="relay-nudge-watcher",
        description="Single generalized nudge watcher for the Agent Relay. "
                    "Handled agents are discovered live from cmux/tmux.",
    )
    parser.add_argument("dir", nargs="?", default=None,
                        help="Directory to watch (default: RELAY_NUDGE_DIR env var)")
    parser.add_argument("--agents", default=None,
                        help="Override the live cmux/tmux discovery with a static "
                             "comma-separated list (for machines this script can't "
                             "introspect, or to pin a fixed set)")
    parser.add_argument("--interval", type=float, default=3.0,
                        help="Poll interval in seconds (default: 3)")
    parser.add_argument("--once", action="store_true",
                        help="Process existing flags and exit (for testing/cron)")
    parser.add_argument("--log", default="/tmp/relay-nudge-watcher.log",
                        help="Append log output to this file (default: /tmp/relay-nudge-watcher.log)")
    args = parser.parse_args()

    watch_dir = args.dir or os.environ.get("RELAY_NUDGE_DIR", "")
    if not watch_dir:
        print("relay-nudge-watcher: error: no watch directory. "
              "Pass it as the first argument or set RELAY_NUDGE_DIR in .relay-env.",
              file=sys.stderr)
        sys.exit(1)
    watch_dir = os.path.expanduser(watch_dir)

    log_file = None
    try:
        log_file = open(args.log, "a")
    except OSError as e:
        print(f"relay-nudge-watcher: warning: cannot open log file {args.log!r}: {e}",
              file=sys.stderr)

    def log(msg):
        line = f"[{datetime.now().strftime('%Y-%m-%d %H:%M:%S')}] [relay-nudge-watcher] {msg}"
        print(line)
        if log_file:
            print(line, file=log_file, flush=True)

    # A static override pins the handled set; otherwise it is discovered live.
    static_agents = None
    if args.agents:
        static_agents = {a.strip().lower() for a in args.agents.split(",") if a.strip()}
        log(f"handled agents (static --agents): {sorted(static_agents)}")
    else:
        log("handled agents: discovered live from cmux/tmux each poll")

    log(f"watching {watch_dir!r} (interval={args.interval}s, once={args.once})")

    def process_flags():
        # Refresh the live session maps so the handled set and the wake targets
        # always reflect the sessions open right now.
        _discover_sessions()
        handled = static_agents if static_agents is not None else _live_agents()

        try:
            entries = os.listdir(watch_dir)
        except OSError as e:
            log(f"ERROR: cannot list {watch_dir!r}: {e}")
            return

        for name in entries:
            if not name.startswith(".nudge-"):
                continue
            agent = name[len(".nudge-"):]
            flag_path = os.path.join(watch_dir, name)

            if agent.lower() not in handled:
                # Not hosted here — leave it for another machine's watcher.
                continue

            # Debounce — wait for the file to stop changing.
            if not _stable_mtime(flag_path):
                continue  # file vanished during debounce

            try:
                with open(flag_path) as f:
                    message = f.read().strip() or "check inbox"
            except OSError:
                continue  # vanished between exists-check and open

            try:
                os.unlink(flag_path)
            except OSError:
                pass  # already removed by a concurrent watcher — still wake

            log(f"handling nudge: agent={agent!r} message={message!r}")
            _wake_agent(agent, message, log)

    if args.once:
        process_flags()
        if log_file:
            log_file.close()
        sys.exit(0)

    while True:
        process_flags()
        time.sleep(args.interval)


if __name__ == "__main__":
    main()
